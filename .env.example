# ── Public hostnames (Caddy Docker Proxy) ────────────────────────────────────
APP_DOMAIN=knowledge-farm.paws.home
API_DOMAIN=api.knowledge-farm.paws.home
CADDY_NETWORK=proxy

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=app
DB_PASSWORD=changeme
DB_NAME=knowledge_farm
DATABASE_URL=postgresql+asyncpg://app:changeme@postgres:5432/knowledge_farm

# ── Access ───────────────────────────────────────────────────────────────────
# The single key that opens the site: the browser asks for it once and keeps a cookie;
# scripts send it as an X-Access-Key header. Empty = no login (local development only).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
ACCESS_KEY=

# ── vonk (local LiteLLM gateway) ─────────────────────────────────────────────
# Required — the app refuses to start without it. Never commit a real value.
VONK_KEY=
VONK_BASE_URL=http://vonk:4000/v1
VONK_MODEL=code
VONK_EMBED_MODEL=embedding
# Draws the report images.
VONK_IMAGE_MODEL=image-fast

# ── Growing ──────────────────────────────────────────────────────────────────
# Related concepts asked per node, and vonk calls in flight while a graph streams.
CONCEPTS_PER_NODE=5
GRAPH_CONCURRENCY=8
# Sections per report (the seed's strongest branches), images drawn at once,
# image size, default report language, and where images are cached.
REPORT_MAX_SECTIONS=6
IMAGE_CONCURRENCY=2
IMAGE_SIZE=1280x720
REPORT_LANGUAGE=English
IMAGE_DIR=/data/gen

# ── Background jobs ──────────────────────────────────────────────────────────
# false: the `worker` container runs queued jobs (they survive API restarts).
# true:  the API process runs them itself; the worker container then stays idle.
JOBS_INLINE=false
# Jobs running at once; the rest wait as "queued".
MAX_CONCURRENT_JOBS=2
# vonk requests in flight at once, across all running jobs.
GENERATION_CONCURRENCY=4

# ── Local access without Caddy ───────────────────────────────────────────────
# Uncomment here and in docker-compose.yml to bind a host port.
# HOST_PORT=8000
