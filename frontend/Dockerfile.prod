# Production image: build the static files, serve them with nginx (docker-compose.prod.yml).
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.30-alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
